    def save_model_package(self, filepath):
        """
        Сохранение полного пакета модели
        """
        if self.model is None:
            raise ValueError("Модель не обучена")
        
        # Создаем директорию если её нет
        os.makedirs(os.path.dirname(filepath) if os.path.dirname(filepath) else '.', exist_ok=True)
        
        # Сохраняем модель в H5 формат
        model_path = f"{filepath}_model.h5"
        self.model.save(model_path)
        
        # Сохраняем метаданные
        metadata = {
            'scaler': self.scaler,
            'label_encoder': self.label_encoder,
            'class_names': self.class_names,
            'input_shape': self.input_shape,
            'num_classes': self.num_classes,
            'metadata': {
                'created': datetime.now().isoformat(),
                'framework': 'tensorflow',
                'version': tf.__version__
            }
        }
        
        # Сохраняем метаданные
        joblib.dump(metadata, f"{filepath}_metadata.pkl")
        
        # Сохраняем историю обучения если есть
        if self.history:
            with open(f"{filepath}_history.json", 'w') as f:
                json.dump(self.history.history, f)
        
        print(f"Модель сохранена в {model_path}")
        print(f"Метаданные сохранены в {filepath}_metadata.pkl")
    
    def load_model_package(self, filepath):
        """
        Загрузка полного пакета модели
        """
        # Загружаем модель
        model_path = f"{filepath}_model.h5"
        if not os.path.exists(model_path):
            raise FileNotFoundError(f"Файл модели {model_path} не найден")
        
        self.model = keras.models.load_model(model_path)
        
        # Загружаем метаданные
        metadata_path = f"{filepath}_metadata.pkl"
        if os.path.exists(metadata_path):
            metadata = joblib.load(metadata_path)
            self.scaler = metadata['scaler']
            self.label_encoder = metadata.get('label_encoder')
            self.class_names = metadata.get('class_names')
            self.input_shape = metadata['input_shape']
            self.num_classes = metadata['num_classes']
        
        # Загружаем историю если есть
        history_path = f"{filepath}_history.json"
        if os.path.exists(history_path):
            with open(history_path, 'r') as f:
                history_dict = json.load(f)
                self.history = type('History', (), {'history': history_dict})()
        
        print(f"Модель загружена из {model_path}")
        return self
    
    def predict_signal(self, signal, return_proba=False):
        """
        Предсказание для одного сигнала
        """
        if self.model is None:
            raise ValueError("Модель не загружена")
        
        # Приводим к правильной форме
        if len(signal.shape) == 1:
            signal = signal.reshape(1, -1)
        
        # Масштабируем
        if self.scaler:
            signal_scaled = self.scaler.transform(
                signal.reshape(-1, signal.shape[-1])
            ).reshape(signal.shape)
        else:
            signal_scaled = signal
        
        # Предсказание
        predictions = self.model.predict(signal_scaled, verbose=0)
        
        if return_proba:
            return predictions[0]
        else:
            pred_class = np.argmax(predictions[0])
            if self.label_encoder:
                return self.label_encoder.inverse_transform([pred_class])[0]
            return pred_class

class SignalPreprocessor:
    """
    Класс для предобработки сигналов
    """
    
    @staticmethod
    def extract_features(signals):
        """
        Извлечение дополнительных признаков из сигналов
        """
        features = []
        
        for signal in signals:
            # Основные статистические признаки
            signal_features = {
                'mean': np.mean(signal),
                'std': np.std(signal),
                'max': np.max(signal),
                'min': np.min(signal),
                'peak_to_peak': np.ptp(signal),
                'rms': np.sqrt(np.mean(signal**2)),
                'zero_crossings': len(np.where(np.diff(np.signbit(signal)))[0]),
                'energy': np.sum(signal**2),
                'entropy': SignalPreprocessor._compute_entropy(signal),
                'skewness': SignalPreprocessor._compute_skewness(signal),
                'kurtosis': SignalPreprocessor._compute_kurtosis(signal)
            }
            
            # Частотные признаки
            freqs, psd = SignalPreprocessor._compute_psd(signal)
            signal_features['dominant_freq'] = freqs[np.argmax(psd)]
            signal_features['spectral_centroid'] = np.sum(freqs * psd) / np.sum(psd)
            
            features.append(list(signal_features.values()))
        
        return np.array(features)
    
    @staticmethod
    def _compute_entropy(signal):
        """Вычисление энтропии сигнала"""
        hist, _ = np.histogram(signal, bins=20, density=True)
        return entropy(hist + 1e-10)
    
    @staticmethod
    def _compute_skewness(signal):
        """Вычисление асимметрии"""
        return np.mean((signal - np.mean(signal))**3) / (np.std(signal)**3 + 1e-10)
    
    @staticmethod
    def _compute_kurtosis(signal):
        """Вычисление эксцесса"""
        return np.mean((signal - np.mean(signal))**4) / (np.std(signal)**4 + 1e-10)
    
    @staticmethod
    def _compute_psd(signal):
        """Вычисление спектральной плотности мощности"""
        freqs = np.fft.fftfreq(len(signal))
        psd = np.abs(np.fft.fft(signal))**2
        return freqs[:len(freqs)//2], psd[:len(psd)//2]
    
    @staticmethod
    def augment_signal(signal, augmentation_type='all'):
        """
        Расширенная аугментация сигналов
        """
        augmented_signals = [signal]
        
        if augmentation_type == 'all' or augmentation_type == 'noise':
            # Разные уровни шума
            for noise_level in [0.01, 0.02, 0.05, 0.1]:
                noise = np.random.normal(0, noise_level * np.std(signal), signal.shape)
                augmented_signals.append(signal + noise)
        
        if augmentation_type == 'all' or augmentation_type == 'time_shift':
            # Временные сдвиги
            for shift in [-20, -10, -5, 5, 10, 20]:
                augmented_signals.append(np.roll(signal, shift))
        
        if augmentation_type == 'all' or augmentation_type == 'scale':
            # Масштабирование
            for scale in [0.7, 0.8, 0.9, 1.1, 1.2, 1.3]:
                augmented_signals.append(signal * scale)
        
        if augmentation_type == 'all' or augmentation_type == 'freq_mask':
            # Маскирование частот
            fft_signal = np.fft.fft(signal)
            for mask_size in [5, 10, 20, 30]:
                fft_masked = fft_signal.copy()
                mask_start = np.random.randint(0, len(fft_signal) - mask_size)
                fft_masked[mask_start:mask_start + mask_size] = 0
                augmented_signals.append(np.fft.ifft(fft_masked).real)
        
        if augmentation_type == 'all' or augmentation_type == 'time_mask':
            # Маскирование во времени
            for mask_size in [10, 20, 30]:
                signal_masked = signal.copy()
                mask_start = np.random.randint(0, len(signal) - mask_size)
                signal_masked[mask_start:mask_start + mask_size] = 0
                augmented_signals.append(signal_masked)
        
        return np.array(augmented_signals)
    
    @staticmethod
    def preprocess_signal(signal, sample_rate=1000):
        """
        Полная предобработка сигнала
        """
        # Удаление тренда
        signal_detrended = signal - np.polyval(np.polyfit(range(len(signal)), signal, 1), range(len(signal)))
        
        # Фильтрация (низкочастотный фильтр)
        sos = signal.butter(10, 0.1, 'low', fs=sample_rate, output='sos')
        signal_filtered = signal.sosfilt(sos, signal_detrended)
        
        # Нормализация
        signal_normalized = (signal_filtered - np.mean(signal_filtered)) / (np.std(signal_filtered) + 1e-10)
        
        return signal_normalized

# Функция для восстановления меток классов
def restore_labels(df, label_column='label'):
    """
    Восстановление меток классов из слабочитаемых строк
    """
    import re
    
    def extract_numbers(text):
        if pd.isna(text):
            return None
        # Ищем все числа в строке
        numbers = re.findall(r'\d+', str(text))
        if numbers:
            return int(numbers[0])
        return None
    
    # Восстанавливаем метки
    df['restored_label'] = df[label_column].apply(extract_numbers)
    
    # Проверяем результаты
    print(f"Восстановлено меток: {df['restored_label'].notna().sum()} из {len(df)}")
    
    # Удаляем строки с невосстановленными метками
    df_clean = df.dropna(subset=['restored_label'])
    df_clean['restored_label'] = df_clean['restored_label'].astype(int)
    
    # Проверяем диапазон классов
    print(f"Классы: {sorted(df_clean['restored_label'].unique())}")
    
    return df_clean

