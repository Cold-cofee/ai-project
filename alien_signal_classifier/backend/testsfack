class SignalPreprocessor:
    @staticmethod
    def preprocess_signal(sig_data, sample_rate=1000):
        # Удаление тренда
        sig_detrended = sp_signal.detrend(sig_data)
        # Фильтрация
        sos = sp_signal.butter(4, 0.1, 'low', fs=sample_rate, output='sos')
        filtered = sp_signal.sosfilt(sos, sig_detrended)
        # Нормализация
        return (filtered - np.mean(filtered)) / (np.std(filtered) + 1e-10)

def complete_pipeline(X, y, class_names=None):
    # 1. Prep
    X_prep = np.array([SignalPreprocessor.preprocess_signal(s) for s in X])
    X_prep = np.expand_dims(X_prep, axis=-1) # (N, L, 1) для Conv1D
    
    le = LabelEncoder()
    y_enc = le.fit_transform(y)
    
    X_train, X_test, y_train, y_test = train_test_split(X_prep, y_enc, test_size=0.2, stratify=y_enc)
    
    # 2. Model
    clf = EnhancedSignalClassifier(input_shape=X_prep.shape[1:], num_classes=len(le.classes_))
    clf.label_encoder = le
    clf.model = clf.create_advanced_network(clf.input_shape, clf.num_classes)
    
    clf.model.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])
    
    # 3. Train
    print("Начало обучения...")
    history = clf.model.fit(
        X_train, y_train, 
        validation_split=0.2, 
        epochs=30, 
        batch_size=32, 
        verbose=1,
        callbacks=[keras.callbacks.EarlyStopping(patience=5, restore_best_weights=True)]
    )
    
    clf.history = history
    clf.plot_training_history(history)
    
    # 4. Eval
    y_pred = np.argmax(clf.model.predict(X_test), axis=1)
    print("\nОтчет о классификации:")
    print(classification_report(y_test, y_pred, target_names=class_names))
    
    return clf

