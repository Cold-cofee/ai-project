        class_id = i % n_classes
        
        if class_id == 0:  # Синусоидальный сигнал
            t = np.linspace(0, 4*np.pi, signal_length)
            signal = np.sin(t) + 0.1 * np.random.randn(signal_length)
        elif class_id == 1:  # Пилообразный сигнал
            signal = signal.sawtooth(2 * np.pi * 5 * np.linspace(0, 1, signal_length))
            signal += 0.1 * np.random.randn(signal_length)
        elif class_id == 2:  # Квадратный сигнал
            signal = signal.square(2 * np.pi * 5 * np.linspace(0, 1, signal_length))
            signal += 0.1 * np.random.randn(signal_length)
        elif class_id == 3:  # Зашумленный сигнал
            signal = np.random.randn(signal_length) * 0.5
        else:  # Модулированный сигнал
            t = np.linspace(0, 1, signal_length)
            carrier = np.sin(2 * np.pi * 10 * t)
            modulator = np.sin(2 * np.pi * 1 * t)
            signal = carrier * (1 + 0.5 * modulator)
            signal += 0.05 * np.random.randn(signal_length)
        
        X.append(signal)
        y.append(class_id)
    
    X = np.array(X)
    y = np.array(y)
    
