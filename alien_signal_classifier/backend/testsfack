class EnhancedSignalClassifier:
    """
    Улучшенный классификатор сигналов с дополнительными функциями
    """
    
    def __init__(self, input_shape=None, num_classes=None):
        self.input_shape = input_shape
        self.num_classes = num_classes
        self.model = None
        self.history = None
        self.scaler = None
        self.label_encoder = None
        self.class_names = None
        self.training_log = []
        
    def create_advanced_network(self, input_shape, num_classes):
        """
        Создание продвинутой архитектуры с несколькими улучшениями
        """
        inputs = keras.Input(shape=input_shape)
        
        # Начальная нормализация
        x = layers.BatchNormalization()(inputs)
        
        # Несколько параллельных путей для захвата разных масштабов признаков
        # Путь 1: Мелкомасштабные признаки (маленькое ядро)
        path1 = layers.Conv1D(filters=32, kernel_size=3, padding='same')(x)
        path1 = layers.BatchNormalization()(path1)
        path1 = layers.Activation('relu')(path1)
        path1 = layers.Conv1D(filters=32, kernel_size=3, padding='same')(path1)
        path1 = layers.BatchNormalization()(path1)
        path1 = layers.Activation('relu')(path1)
        
        # Путь 2: Среднемасштабные признаки
        path2 = layers.Conv1D(filters=32, kernel_size=7, padding='same')(x)
        path2 = layers.BatchNormalization()(path2)
        path2 = layers.Activation('relu')(path2)
        path2 = layers.Conv1D(filters=32, kernel_size=7, padding='same')(path2)
        path2 = layers.BatchNormalization()(path2)
        path2 = layers.Activation('relu')(path2)
        
        # Путь 3: Крупномасштабные признаки
        path3 = layers.Conv1D(filters=32, kernel_size=11, padding='same')(x)
        path3 = layers.BatchNormalization()(path3)
        path3 = layers.Activation('relu')(path3)
        path3 = layers.Conv1D(filters=32, kernel_size=11, padding='same')(path3)
        path3 = layers.BatchNormalization()(path3)
        path3 = layers.Activation('relu')(path3)
        
        # Объединение путей
        x = layers.Concatenate()([path1, path2, path3])
        x = layers.MaxPooling1D(pool_size=2)(x)
        x = layers.Dropout(0.1)(x)
        
        # Блок с расширенными остаточными связями
        for filters in [64, 128, 256, 512]:
            # Сохраняем для остаточной связи
            shortcut = x
            
            # Основной путь
            x = layers.Conv1D(filters=filters, kernel_size=3, padding='same')(x)
            x = layers.BatchNormalization()(x)
            x = layers.Activation('relu')(x)
            
            x = layers.Conv1D(filters=filters, kernel_size=3, padding='same')(x)
            x = layers.BatchNormalization()(x)
            
            # Адаптация shortcut если нужно
            if shortcut.shape[-1] != filters:
                shortcut = layers.Conv1D(filters=filters, kernel_size=1)(shortcut)
            
            # Остаточная связь
            x = layers.Add()([x, shortcut])
            x = layers.Activation('relu')(x)
            
            # Squeeze-and-Excitation блок
            se = layers.GlobalAveragePooling1D()(x)
            se = layers.Dense(filters // 4, activation='relu')(se)
            se = layers.Dense(filters, activation='sigmoid')(se)
            se = layers.Reshape((1, filters))(se)
            x = layers.Multiply()([x, se])
            
            x = layers.MaxPooling1D(pool_size=2)(x)
            x = layers.Dropout(0.2)(x)
        
        # Глобальный пулинг
        x = layers.GlobalAveragePooling1D()(x)
        
        # Внимание на уровне признаков
        attention = layers.Dense(512, activation='tanh')(x)
        attention = layers.Dense(512, activation='sigmoid')(attention)
        x = layers.Multiply()([x, attention])
        
        # Классификационная головка
        x = layers.Dense(1024, kernel_regularizer=keras.regularizers.l1_l2(l1=0.0001, l2=0.0001))(x)
        x = layers.BatchNormalization()(x)
        x = layers.Activation('relu')(x)
        x = layers.Dropout(0.5)(x)
        
        x = layers.Dense(512, kernel_regularizer=keras.regularizers.l1_l2(l1=0.0001, l2=0.0001))(x)
        x = layers.BatchNormalization()(x)
        x = layers.Activation('relu')(x)
        x = layers.Dropout(0.4)(x)
        
        x = layers.Dense(256, kernel_regularizer=keras.regularizers.l1_l2(l1=0.0001, l2=0.0001))(x)
        x = layers.BatchNormalization()(x)
        x = layers.Activation('relu')(x)
        x = layers.Dropout(0.3)(x)
        
        outputs = layers.Dense(num_classes, activation='softmax')(x)
        
        model = keras.Model(inputs=inputs, outputs=outputs)
        return model
    
    def train_with_cv(self, X, y, n_splits=5, epochs=150, batch_size=32):
        """
        Обучение с кросс-валидацией
        """
        skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=42)
        cv_scores = []
        cv_models = []
        
        # Кодирование меток если необходимо
        if self.label_encoder is None:
            self.label_encoder = LabelEncoder()
            y_encoded = self.label_encoder.fit_transform(y)
        else:
            y_encoded = self.label_encoder.transform(y)
        
        for fold, (train_idx, val_idx) in enumerate(skf.split(X, y_encoded)):
            print(f"\n{'='*50}")
            print(f"Fold {fold + 1}/{n_splits}")
            print(f"{'='*50}")
            
            X_train, X_val = X[train_idx], X[val_idx]
            y_train, y_val = y_encoded[train_idx], y_encoded[val_idx]
            
            # Нормализация для этого фолда
            scaler = StandardScaler()
            X_train_scaled = scaler.fit_transform(
                X_train.reshape(-1, X_train.shape[-1])
            ).reshape(X_train.shape)
            X_val_scaled = scaler.transform(
                X_val.reshape(-1, X_val.shape[-1])
            ).reshape(X_val.shape)
            
            # Создание и обучение модели
            model = self.create_advanced_network(X.shape[1:], len(np.unique(y_encoded)))
            
            # Компиляция
            optimizer = keras.optimizers.AdamW(
                learning_rate=0.001,
                weight_decay=0.0001
            )
            
            model.compile(
                optimizer=optimizer,
                loss='sparse_categorical_crossentropy',
                metrics=['accuracy', keras.metrics.AUC(name='auc')]
            )
            
            # Колбэки
            callbacks = [
                keras.callbacks.EarlyStopping(
                    monitor='val_loss',
                    patience=15,
                    restore_best_weights=True,
                    verbose=0
                ),
                keras.callbacks.ReduceLROnPlateau(
                    monitor='val_loss',
                    factor=0.5,
                    patience=7,
                    min_lr=0.00001,
                    verbose=0
                )
            ]
            
            # Обучение
            history = model.fit(
                X_train_scaled, y_train,
                validation_data=(X_val_scaled, y_val),
                epochs=epochs,
                batch_size=batch_size,
                callbacks=callbacks,
                verbose=0
            )
            
            # Оценка
            val_loss, val_acc, val_auc = model.evaluate(X_val_scaled, y_val, verbose=0)
            cv_scores.append({
                'fold': fold,
                'val_accuracy': val_acc,
                'val_auc': val_auc,
                'val_loss': val_loss
            })
            
            cv_models.append((model, scaler))
            
            print(f"Fold {fold + 1} - Accuracy: {val_acc:.4f}, AUC: {val_auc:.4f}")
        
        # Вывод результатов CV
        print("\n" + "="*50)
        print("РЕЗУЛЬТАТЫ КРОСС-ВАЛИДАЦИИ")
        print("="*50)
        mean_acc = np.mean([score['val_accuracy'] for score in cv_scores])
        std_acc = np.std([score['val_accuracy'] for score in cv_scores])
        mean_auc = np.mean([score['val_auc'] for score in cv_scores])
        std_auc = np.std([score['val_auc'] for score in cv_scores])
        
        print(f"Средняя точность: {mean_acc:.4f} ± {std_acc:.4f}")
        print(f"Средний AUC: {mean_auc:.4f} ± {std_auc:.4f}")
        
        return cv_models, cv_scores
    
    def ensemble_predict(self, models_list, X, weights=None):
        """
        Ансамблевое предсказание
        """
        if weights is None:
            weights = [1/len(models_list)] * len(models_list)
        
        predictions = []
        for (model, scaler), weight in zip(models_list, weights):
            X_scaled = scaler.transform(X.reshape(-1, X.shape[-1])).reshape(X.shape)
            pred = model.predict(X_scaled, verbose=0)
            predictions.append(pred * weight)
        
        ensemble_pred = np.sum(predictions, axis=0)
        return ensemble_pred
    
